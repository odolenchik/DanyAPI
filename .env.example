# DeepSeek provider: one or more bearer tokens, comma-separated
DEEPSEEK_TOKENS=
# DeepSeek provider: single bearer token (used only if DEEPSEEK_TOKENS is empty)
DEEPSEEK_TOKEN=
# DeepSeek provider: email login fallback (used only if no tokens are set)
DEEPSEEK_EMAIL=
# DeepSeek provider: password for email login
DEEPSEEK_PASSWORD=

# Qwen provider: one or more refresh tokens, comma-separated.
#
# The credential is NOT a bearer token: frontend 0.3.12 exchanges it for a
# short-lived access token via auth.qwen.ai. Take it from DevTools ->
# Application -> Cookies -> chat.qwen.ai -> `refresh_token` (~297 chars, its
# JWT payload has "type":"refresh_token"). It lives ~30 days and is not
# renewed by use. A legacy `token` cookie will be rejected as revoked.
QWEN_TOKENS=
# Qwen provider: single refresh token (used only if QWEN_TOKENS is empty)
QWEN_TOKEN=
# Qwen provider: email login fallback (used only if no tokens are set)
QWEN_EMAIL=
# Qwen provider: password for email login
QWEN_PASSWORD=

# z.ai provider: one or more bearer tokens, comma-separated (optional — the
# provider authenticates through a persistent Chrome profile by default)
ZAI_TOKENS=
# z.ai provider: single bearer token (used only if ZAI_TOKENS is empty)
ZAI_TOKEN=
# z.ai provider: enable without any token, using the persistent Chrome profile only
DANYAPI_ZAI_ENABLED=
# z.ai provider: Chrome profile directory (default ~/.danyapi/zai-browser)
ZAI_BROWSER_DIR=
# z.ai provider: email login fallback (used only if no tokens are set)
ZAI_EMAIL=
# z.ai provider: password for email login
ZAI_PASSWORD=

# address the API server binds to
DANYAPI_HOST=0.0.0.0
# port the API server listens on
DANYAPI_PORT=8000
# upstream request timeout in seconds
DANYAPI_TIMEOUT=60
# seconds to wait for a free account before returning 429 (empty = wait forever)
DANYAPI_ACQUIRE_TIMEOUT=
# minimum seconds between consecutive requests to one account (0 = disabled)
DANYAPI_MIN_REQUEST_INTERVAL=4.0
# how many requests may go back-to-back before that interval applies
DANYAPI_REQUEST_BURST=4
# minimum seconds between consecutive isolated (single) request starts (0 = disabled)
DANYAPI_MIN_START_GAP=0
# minimum seconds between the END of one request and the START of the next on the same
# account (0 = disabled). Guards against chained long requests: with start-to-start
# pacing alone, an ~80 s request makes consecutive starts look far apart while the
# account is re-hit seconds after the previous stream closed.
DANYAPI_MIN_END_GAP=5.0
# max server-side chats cached per provider (LRU) for stateless session reuse
DANYAPI_SESSION_CACHE_SIZE=128
# seconds an unused session/context stays reusable (0 = never expire)
DANYAPI_SESSION_TTL_SECONDS=3600
# how long a Qwen account is dropped from rotation after its daily quota is used
# up (Qwen resets the image quota daily, so the default is one day)
DANYAPI_QWEN_QUOTA_COOLDOWN=86400

# --- Qwen browser transport ---
# chat.qwen.ai sits behind Alibaba's baxia risk control: a plain HTTP client is
# answered with a captcha no matter how slowly it is driven, and only a request
# the SPA itself issues gets through. So Qwen requests (text and images) are
# driven through a real browser; the HTTP client is still used for the auth
# handshake and chat creation.
# set to 0/false to fall back to plain HTTP (which will meet the captcha wall)
DANYAPI_QWEN_BROWSER=1
# seconds one browser request may take; a request types the prompt, waits for
# the page to render and only then answers (30 minimum)
DANYAPI_QWEN_BROWSER_TIMEOUT=240
# how long the window stays open for a human to solve a captcha before the
# request fails; 0 reports the captcha immediately instead of waiting
DANYAPI_QWEN_CAPTCHA_WAIT=0
# how long an account rests after a captcha; only a human can clear it, so the
# account stays out of rotation and returns on its own once the cooldown passes
DANYAPI_QWEN_CAPTCHA_COOLDOWN=3600
# browser pacing: one browser request already takes 30-70 s, so instead of
# bursts with long rests every request waits this think time plus a random
# jitter (seconds). 0 disables browser pacing.
DANYAPI_QWEN_BROWSER_INTERVAL=20
DANYAPI_QWEN_BROWSER_INTERVAL_JITTER=20
# path to the browser binary; empty lets patchright use its own Chromium. Set it
# when the machine already has a Playwright Chromium to avoid a second download.
QWEN_BROWSER_EXECUTABLE=
# base directory for browser profiles; one profile per account is created under
# it (qwen-browser-0, qwen-browser-1, ...). Empty means ~/.danyapi.
QWEN_BROWSER_DIR=
# seconds between re-checks of a DeepSeek account marked broken (auth error). A
# broken account may only mean the network was down, so a background loop probes
# it and returns it to rotation once the token checks out again (min 60)
DANYAPI_DEEPSEEK_REVIVE_INTERVAL=900
# slower re-check cadence for an account broken for longer than
# DANYAPI_DEEPSEEK_REVIVE_SLOW_AFTER seconds (min 60)
DANYAPI_DEEPSEEK_REVIVE_SLOW_INTERVAL=1800
# how long an account must stay broken before the slower cadence applies (min 60)
DANYAPI_DEEPSEEK_REVIVE_SLOW_AFTER=7200
# the same three knobs for Qwen accounts marked broken by an auth error. A Qwen
# credential is a refresh token the server rotates, so a break is often just the
# HTTP client holding a copy the browser already replaced; the loop re-probes it
# and returns it to rotation once the store yields a working credential (min 60)
DANYAPI_QWEN_REVIVE_INTERVAL=900
DANYAPI_QWEN_REVIVE_SLOW_INTERVAL=1800
DANYAPI_QWEN_REVIVE_SLOW_AFTER=7200
# directory for on-disk session cache (default = system temp dir, namespaced by
# listen port: /tmp/danyapi-8000, so instances never share one cache)
DANYAPI_CACHE_DIR=
# set to 1/true/yes to disable on-disk cache entirely
DANYAPI_CACHE_DISABLED=
# log level: DEBUG, INFO, WARNING, ERROR
DANYAPI_LOG_LEVEL=INFO
# file path for persistent logs (empty = console only)
DANYAPI_LOG_FILE=
# max log file size in bytes before rotation
DANYAPI_LOG_MAX_BYTES=10485760
# number of rotated log files to keep
DANYAPI_LOG_BACKUP_COUNT=3
# token usage accounting (0/false/no/off disables the tracker and /v1/usage)
DANYAPI_USAGE_ENABLED=1
# how many recent per-request usage records to keep in memory
DANYAPI_USAGE_MAX_RECORDS=1000
# auto-update to the latest GitHub release on each start (0 disables)
DANYAPI_AUTO_UPDATE=1
# retry once when a tool-mode reply fails to parse and tool_choice="auto"
# (1/true/yes/on enables); a forced tool_choice always retries regardless
DANYAPI_TOOLCALL_RETRY=0
# abort a DeepSeek stream that collapses into a runaway repeat of the empty DSML
# calls container (long multi-call turns can lose EOS and repeat it to the limit);
# the valid call payload is already buffered, so the tail is pure waste (0 disables)
DANYAPI_DEGENERATE_GUARD=1

# Stop a turn that keeps emitting the SAME tool call round after round
# (0 = only log it). Threshold = how many identical rounds in a row.
DANYAPI_REPEAT_GUARD=1
DANYAPI_REPEAT_THRESHOLD=5
# adjacent empty-container repeats needed to declare the stream degenerate
DANYAPI_DEGENERATE_THRESHOLD=20
# per-turn thinking heuristic: when the client sends neither `thinking` nor
# `reasoning_effort`, decide from the turn itself (1/true/yes/on enables)
DANYAPI_THINKING_HEURISTIC=0
# a user turn at or above this many characters counts as hard
DANYAPI_THINKING_MIN_PROMPT_CHARS=2000
# a conversation with at least this many messages counts as hard
DANYAPI_THINKING_MIN_MESSAGES=8
# hard-turn signals add up to a score; reaching the threshold turns thinking
# on. A strong signal (long prompt, error/difficulty cue) clears it alone;
# weak ones (long history, automatic tool round) must combine
DANYAPI_THINKING_STRONG_WEIGHT=2
DANYAPI_THINKING_WEAK_WEIGHT=1
DANYAPI_THINKING_SCORE_THRESHOLD=2